<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        С Android 5 строка состояния прозрачная, а её содержимое рисуем
        под собой сами: в оригинале верхняя панель тоже уходит под
        строку состояния, и отступ отмеряется по ней.
    -->
    <style name="TroubadourTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorBackground">@color/window_background</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
